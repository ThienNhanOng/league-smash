{
  "_about": "One row per League champion in the roster. Every path is read from the player's own League install ({game:league-of-legends}/Game/DATA/FINAL/Champions/<wad>); nothing here is shipped.",
  "columns": {
    "id": "skin id injected into the base fighter (lol_<name>)",
    "name": "display name on the select screen",
    "wad": "champion WAD file name in DATA/FINAL/Champions",
    "voWad": "localized WAD holding the voice-line .wpk",
    "base": "Slap City fighter id whose moveset and hitboxes the champion uses (sheet: slap_fighters)",
    "slot": "position in the new champion row, left to right",
    "skn": "mesh path inside the WAD",
    "skl": "skeleton path inside the WAD",
    "tex": "main diffuse texture",
    "texBySubmesh": "submesh name -> texture path, for submeshes that do not use tex",
    "hideSubmeshes": "submeshes not drawn in battle (recall props, effect smears, alternate weapons)",
    "icon": "square champion icon for the roster slot",
    "portrait": "loading-screen art shown in the player box",
    "height": "drawn height in Slap City units (stage props for scale: the default fighters stand about 3.5 to 4.5)",
    "yaw": "extra model rotation in degrees so the champion faces along the stage",
    "sfxBank": "Wwise sound-effect bank (.bnk with embedded audio)",
    "sfxEvents": "Wwise events bank for sfx",
    "voAudio": "voice-line .wpk in voWad",
    "voEvents": "Wwise events bank for voice lines (searched in voWad, then wad)",
    "voSelect": "voice event played when the champion is picked",
    "voKO": "voice event played when the champion is knocked out",
    "voTaunt": "voice event played on the base fighter's taunt"
  },
